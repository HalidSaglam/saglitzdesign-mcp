{
  "name": "saglitzdesign-mcp",
  "version": "0.29.0",
  "mcpName": "io.github.HalidSaglam/saglitzdesign-mcp",
  "description": "SaglitzDesign — expert MCP server for mobile app & website design: UI, UX, buttons, design languages, SEO and GEO guidance backed by a curated knowledge base and real-world pattern research.",
  "type": "module",
  "bin": {
    "saglitzdesign-mcp": "dist/bin.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "knowledge",
    "recipes",
    "!knowledge/examples/images",
    "scripts/regenerate-examples.md",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "preflight": "node scripts/preflight-release.mjs",
    "smoke": "node scripts/smoke-pack.mjs",
    "version": "node scripts/sync-version.mjs && git add server.json",
    "prepublishOnly": "npm run build && vitest run && npm run preflight"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design",
    "ui",
    "ux",
    "seo",
    "geo",
    "design-system",
    "mobile-design",
    "web-design",
    "claude"
  ],
  "license": "MIT",
  "homepage": "https://saglitz.com/apps/saglitzdesign",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HalidSaglam/saglitzdesign-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/HalidSaglam/saglitzdesign-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "author": "Saglitz Design"
}
